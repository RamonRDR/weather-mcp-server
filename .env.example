# The initial backend uses the existing Weather Cache API for current weather.
# Start the API separately, or choose MCP_BACKEND=open_meteo.
MCP_BACKEND=cache_api
MCP_CACHE_API_BASE_URL=http://127.0.0.1:8000
MCP_HTTP_TIMEOUT_SECONDS=5
MCP_RATE_LIMIT_CALLS=60
MCP_RATE_LIMIT_WINDOW_SECONDS=60
MCP_LOG_LEVEL=INFO
# MCP_BACKEND=mock provides *fictional, fixed* demonstration data, never live weather.
